# Copy to .env.local and fill in. Never commit real values.

# Neon — pooled connection string (host contains "-pooler")
DATABASE_URL=
# Neon — direct connection string, used for migrations
DATABASE_URL_UNPOOLED=
PAYLOAD_SECRET=

# Vercel Blob (media uploads). Leave empty locally to store uploads in ./media
BLOB_READ_WRITE_TOKEN=

# Contact form. Without RESEND_API_KEY + CONTACT_TO_EMAIL enquiries are saved but not emailed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional. Needs a domain verified in Resend, e.g. "TaxBridge <website@yourdomain.com.au>"
CONTACT_FROM_EMAIL=
# Cloudflare Turnstile. Without both keys the form relies on its hidden spam-trap field.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tests: put this in .env.test.local ---
# A separate database (a Neon branch or local Postgres). Tests create and delete data.
# TEST_DATABASE_URL=
